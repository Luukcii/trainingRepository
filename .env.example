# Variable names only. Never commit real values.

# App runtime (.env.local, and Vercel env vars)
DATABASE_URL=            # app_user via Neon pooler: rows only, no table changes
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=          # sending-only key; never a full-access key
DISCORD_PUBLIC_KEY=      # faction-war bot: checks Discord's signatures (public by design)
DISCORD_GUILD_ID=        # the HAFW server; the bot refuses every other server
WAR_STAFF_ROLE_ID=       # optional: a Discord role allowed to use /warstaff
ANTHROPIC_API_KEY=       # optional: God's free answers (/war ask). Console key with a monthly spend limit

# Admin tokens (.env.tools only — never in Vercel)
# DATABASE_ADMIN_URL=    # neondb_owner, for migrations
# NEON_TOKEN=            # project-scoped API key
# DISCORD_BOT_TOKEN=     # only for npm run discord:register; never in Vercel
# DISCORD_APPLICATION_ID=
# GITHUB_TOKEN=          # fine-grained, this repo only
# VERCEL_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# S3_API_ENDPOINT=
